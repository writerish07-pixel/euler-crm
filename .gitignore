# Frontend build-time config: these contain ONLY the public API URL (CRA inlines
# REACT_APP_* into the browser bundle, so a secret could never live here anyway).
# They must be committed or the production build compiles an undefined API base.
!frontend/.env.production
!frontend/.env.development
frontend/build/

# Capacitor native build outputs (the android/ and ios/ projects themselves are committed)
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/captures/
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/DerivedData/
